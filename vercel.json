{
  "rewrites": [
    {
      "source": "/",
      "destination": "/app/dashboard/command-center.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!data/canonical-market.json' ':!data/history-index.json'"
}
